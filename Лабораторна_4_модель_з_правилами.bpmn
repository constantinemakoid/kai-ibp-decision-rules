<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IBP4" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ibp4_gen_model.py" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:message id="Message_Alert" name="Первинне сповіщення" />
  <bpmn:message id="Message_RightsReq" name="Запит фактичних повноважень" />
  <bpmn:message id="Message_HeadNotice" name="Повідомлення про підтверджений інцидент" />
  <bpmn:message id="Message_Decision" name="Рішення про обмеження доступу" />
  <bpmn:message id="Message_Done" name="Підтвердження обмеження доступу" />
  <bpmn:message id="Message_HeadDecision" name="Рішення щодо організаційних заходів" />
  <bpmn:collaboration id="Collaboration_IncidentResponse_Rules">
    <bpmn:participant id="Participant_Audit" name="Система аудиту документообігу" processRef="Process_Audit" />
    <bpmn:participant id="Participant_IB" name="Служба ІБ" processRef="Process_IB" />
    <bpmn:participant id="Participant_IAM" name="Система IAM" processRef="Process_IAM" />
    <bpmn:participant id="Participant_Head" name="Підрозділ користувача" processRef="Process_Head" />
    <bpmn:messageFlow id="MsgFlow_Alert" name="Первинне сповіщення" sourceRef="Task_Register" targetRef="Start_Alert" />
    <bpmn:messageFlow id="MsgFlow_RightsReq" name="Запит фактичних повноважень" sourceRef="Task_Enrich" targetRef="Start_IAM_Rights" />
    <bpmn:messageFlow id="MsgFlow_RightsData" name="Дані про фактичні повноваження" sourceRef="Task_ProvideRights" targetRef="Task_Enrich" />
    <bpmn:messageFlow id="MsgFlow_HeadNotice" name="Повідомлення про підтверджений інцидент" sourceRef="Throw_HeadNotice" targetRef="Start_Head" />
    <bpmn:messageFlow id="MsgFlow_Decision" name="Рішення про обмеження доступу" sourceRef="Task_SendDecision" targetRef="Start_IAM_Restrict" />
    <bpmn:messageFlow id="MsgFlow_Done" name="Підтвердження обмеження доступу" sourceRef="Task_Restrict" targetRef="Catch_RestrictDone" />
    <bpmn:messageFlow id="MsgFlow_HeadDecision" name="Рішення щодо організаційних заходів" sourceRef="End_Head" targetRef="Catch_HeadDecision" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Audit" isExecutable="false">
    <bpmn:startEvent id="Start_Audit" name="Зафіксовано перегляд і копіювання документів іншого підрозділу">
      <bpmn:documentation>Початкова подія процесу.</bpmn:documentation>
      <bpmn:outgoing>Flow_A1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Register" name="Сформувати запис аудиту та сповіщення">
      <bpmn:documentation>Без змін відносно ЛР 3.</bpmn:documentation>
      <bpmn:incoming>Flow_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Audit" name="Запис і сповіщення сформовано">
      <bpmn:documentation>Завершення фрагмента системи аудиту.</bpmn:documentation>
      <bpmn:incoming>Flow_A2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A1" sourceRef="Start_Audit" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_Register" targetRef="End_Audit" />
  </bpmn:process>
  <bpmn:process id="Process_IB" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_IB">
      <bpmn:lane id="Lane_SOC" name="Черговий SOC">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Activity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DocRoutine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Routine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IB" name="Фахівець з ІБ">
        <bpmn:flowNodeRef>Task_CheckGrounds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Grounds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseUnconf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Classify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixRights</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Platform" name="Платформа обробки інцидентів">
        <bpmn:flowNodeRef>Start_Alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Enrich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rule_D1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rule_D2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_HeadNotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_RestrictDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyRights</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rule_D3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RightsOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_HeadDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DraftReport</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Alert" name="Отримано первинне сповіщення">
      <bpmn:documentation>Сповіщення надходить на платформу.</bpmn:documentation>
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_Alert_def" messageRef="Message_Alert" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CreateCard" name="Зареєструвати картку інциденту">
      <bpmn:documentation>Без змін відносно ЛР 3.</bpmn:documentation>
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Enrich" name="Зібрати контекст: DLP, IAM, підрозділ">
      <bpmn:documentation>Отримання даних для D1 і D2: журнал аудиту, DLP, права і доручення IAM, кадрові дані.</bpmn:documentation>
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_P3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Score" name="Оцінити ризик R і визначити рівень">
      <bpmn:documentation>Обчислення R і ознак f1...f6; рівень за порогами Rсер і Rвис.</bpmn:documentation>
      <bpmn:incoming>Flow_P3</bpmn:incoming>
      <bpmn:outgoing>Flow_P4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Rule_D1" name="Застосувати правила D1: значущість події">
      <bpmn:documentation>Таблиця рішень D1_Significance, правила R1.1...R1.7.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="D1_Significance" resultVariable="d1" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P4</bpmn:incoming>
      <bpmn:outgoing>Flow_P4b</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="Task_Review" name="Підтвердити рекомендацію D1 або змінити з обґрунтуванням">
      <bpmn:documentation>Рівень B: зміна рекомендації можлива лише при d1.overrideAllowed = true; результат d1Final.</bpmn:documentation>
      <bpmn:incoming>Flow_P4b</bpmn:incoming>
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Activity" name="Рішення D1: ескалувати?">
      <bpmn:documentation>Точка рішення D1.</bpmn:documentation>
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_S2_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_S2_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_DocRoutine" name="Закрити картку як штатну подію">
      <bpmn:documentation>Гілка «Ні» точки рішення D1.</bpmn:documentation>
      <bpmn:incoming>Flow_S2_no</bpmn:incoming>
      <bpmn:outgoing>Flow_S3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Routine" name="Подію закрито як штатну">
      <bpmn:documentation>Кінцевий результат: подія штатна.</bpmn:documentation>
      <bpmn:incoming>Flow_S3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Evidence" name="Сформувати пакет доказів і призначити фахівцю з ІБ">
      <bpmn:documentation>Обчислення k, h для D2.</bpmn:documentation>
      <bpmn:incoming>Flow_S2_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_P5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Rule_D2" name="Застосувати правила D2: підстави доступу">
      <bpmn:documentation>Таблиця рішень D2_Grounds, правила R2.1...R2.5.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="D2_Grounds" resultVariable="d2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P5</bpmn:incoming>
      <bpmn:outgoing>Flow_P5b</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="Task_CheckGrounds" name="Перевірити пакет доказів і рекомендацію D2">
      <bpmn:documentation>Рівень B, правило R2.6: фахівець з ІБ підтверджує або змінює рекомендацію; при d2.aggravating = true результат «підстави наявні» лише з документальним підтвердженням керівника; результат d2Final.</bpmn:documentation>
      <bpmn:incoming>Flow_P5b</bpmn:incoming>
      <bpmn:outgoing>Flow_I1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Grounds" name="Рішення D2: підстави відсутні?">
      <bpmn:documentation>Точка рішення D2.</bpmn:documentation>
      <bpmn:incoming>Flow_I1</bpmn:incoming>
      <bpmn:outgoing>Flow_I2_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_I2_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CloseUnconf" name="Закрити подію як непідтверджену">
      <bpmn:documentation>Гілка «Ні» точки рішення D2.</bpmn:documentation>
      <bpmn:incoming>Flow_I2_no</bpmn:incoming>
      <bpmn:outgoing>Flow_I3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_NotConfirmed" name="Інцидент не підтверджено">
      <bpmn:documentation>Кінцевий результат: інцидент не підтверджено.</bpmn:documentation>
      <bpmn:incoming>Flow_I3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Classify" name="Підтвердити критичність і захід обмеження">
      <bpmn:documentation>Без змін відносно ЛР 3.</bpmn:documentation>
      <bpmn:incoming>Flow_I2_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_I4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Throw_HeadNotice" name="Повідомлення керівнику надіслано">
      <bpmn:documentation>Без змін відносно ЛР 3.</bpmn:documentation>
      <bpmn:incoming>Flow_I4</bpmn:incoming>
      <bpmn:outgoing>Flow_I5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Throw_HeadNotice_def" messageRef="Message_HeadNotice" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:documentation>Об'єднання основного потоку і повтору R3.2.</bpmn:documentation>
      <bpmn:incoming>Flow_I5</bpmn:incoming>
      <bpmn:incoming>Flow_P10_retry</bpmn:incoming>
      <bpmn:outgoing>Flow_P6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SendDecision" name="Передати IAM рішення про обмеження доступу">
      <bpmn:documentation>Лічильник передач attempt збільшується на 1.</bpmn:documentation>
      <bpmn:incoming>Flow_P6</bpmn:incoming>
      <bpmn:outgoing>Flow_P7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Catch_RestrictDone" name="Обмеження доступу підтверджено">
      <bpmn:documentation>Очікування підтвердження від IAM.</bpmn:documentation>
      <bpmn:incoming>Flow_P7</bpmn:incoming>
      <bpmn:outgoing>Flow_P8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_RestrictDone_def" messageRef="Message_Done" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_VerifyRights" name="Визначити розбіжність прав із рішенням">
      <bpmn:documentation>Отримання даних для D3: mismatch.</bpmn:documentation>
      <bpmn:incoming>Flow_P8</bpmn:incoming>
      <bpmn:outgoing>Flow_P9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Rule_D3" name="Застосувати правила D3: контроль прав">
      <bpmn:documentation>Таблиця рішень D3_Containment, правила R3.1...R3.4, рівень C.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="D3_Containment" resultVariable="d3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P9</bpmn:incoming>
      <bpmn:outgoing>Flow_P9b</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_RightsOk" name="Результат D3">
      <bpmn:documentation>Точка рішення D3, автоматична.</bpmn:documentation>
      <bpmn:incoming>Flow_P9b</bpmn:incoming>
      <bpmn:outgoing>Flow_P10_retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_P10_esc</bpmn:outgoing>
      <bpmn:outgoing>Flow_P10_ok</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FixRights" name="Усунути розбіжність прав і підтвердити стан">
      <bpmn:documentation>Правила R3.3 і R3.4: рішення передано фахівцю з ІБ.</bpmn:documentation>
      <bpmn:incoming>Flow_P10_esc</bpmn:incoming>
      <bpmn:outgoing>Flow_F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MergeOk">
      <bpmn:documentation>Об'єднання гілок R3.1 і ручного усунення.</bpmn:documentation>
      <bpmn:incoming>Flow_P10_ok</bpmn:incoming>
      <bpmn:incoming>Flow_F1</bpmn:incoming>
      <bpmn:outgoing>Flow_I6a</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Catch_HeadDecision" name="Отримано рішення керівника">
      <bpmn:documentation>Без змін відносно ЛР 3.</bpmn:documentation>
      <bpmn:incoming>Flow_I6a</bpmn:incoming>
      <bpmn:outgoing>Flow_I6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_HeadDecision_def" messageRef="Message_HeadDecision" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_DraftReport" name="Сформувати чернетку звіту з картки інциденту">
      <bpmn:documentation>До звіту включаються результати D1, D2, D3 і номери правил, що спрацювали.</bpmn:documentation>
      <bpmn:incoming>Flow_I6</bpmn:incoming>
      <bpmn:outgoing>Flow_P11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ApproveReport" name="Перевірити та затвердити звіт">
      <bpmn:documentation>Без змін відносно ЛР 3.</bpmn:documentation>
      <bpmn:incoming>Flow_P11</bpmn:incoming>
      <bpmn:outgoing>Flow_I7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Report" name="Інцидент закрито зі звітом">
      <bpmn:documentation>Кінцевий результат: звіт і обмеження доступу.</bpmn:documentation>
      <bpmn:incoming>Flow_I7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P1" sourceRef="Start_Alert" targetRef="Task_CreateCard" />
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_CreateCard" targetRef="Task_Enrich" />
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Task_Enrich" targetRef="Task_Score" />
    <bpmn:sequenceFlow id="Flow_P4" sourceRef="Task_Score" targetRef="Rule_D1" />
    <bpmn:sequenceFlow id="Flow_P4b" sourceRef="Rule_D1" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_S1" sourceRef="Task_Review" targetRef="Gateway_Activity" />
    <bpmn:sequenceFlow id="Flow_S2_yes" name="Так" sourceRef="Gateway_Activity" targetRef="Task_Evidence">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= d1Final = "ескалувати"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S2_no" name="Ні" sourceRef="Gateway_Activity" targetRef="Task_DocRoutine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= d1Final = "закрити як штатну"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_DocRoutine" targetRef="End_Routine" />
    <bpmn:sequenceFlow id="Flow_P5" sourceRef="Task_Evidence" targetRef="Rule_D2" />
    <bpmn:sequenceFlow id="Flow_P5b" sourceRef="Rule_D2" targetRef="Task_CheckGrounds" />
    <bpmn:sequenceFlow id="Flow_I1" sourceRef="Task_CheckGrounds" targetRef="Gateway_Grounds" />
    <bpmn:sequenceFlow id="Flow_I2_yes" name="Так" sourceRef="Gateway_Grounds" targetRef="Task_Classify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= d2Final = "підстави відсутні"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_I2_no" name="Ні" sourceRef="Gateway_Grounds" targetRef="Task_CloseUnconf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= d2Final = "підстави наявні"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_I3" sourceRef="Task_CloseUnconf" targetRef="End_NotConfirmed" />
    <bpmn:sequenceFlow id="Flow_I4" sourceRef="Task_Classify" targetRef="Throw_HeadNotice" />
    <bpmn:sequenceFlow id="Flow_I5" sourceRef="Throw_HeadNotice" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_P6" sourceRef="Gateway_Merge" targetRef="Task_SendDecision" />
    <bpmn:sequenceFlow id="Flow_P7" sourceRef="Task_SendDecision" targetRef="Catch_RestrictDone" />
    <bpmn:sequenceFlow id="Flow_P8" sourceRef="Catch_RestrictDone" targetRef="Task_VerifyRights" />
    <bpmn:sequenceFlow id="Flow_P9" sourceRef="Task_VerifyRights" targetRef="Rule_D3" />
    <bpmn:sequenceFlow id="Flow_P9b" sourceRef="Rule_D3" targetRef="Gateway_RightsOk" />
    <bpmn:sequenceFlow id="Flow_P10_retry" name="Повторити" sourceRef="Gateway_RightsOk" targetRef="Gateway_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= d3.result = "повторити передачу"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_P10_esc" name="Ескалувати" sourceRef="Gateway_RightsOk" targetRef="Task_FixRights">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= d3.result = "ескалувати фахівцю"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_P10_ok" name="Відповідає" sourceRef="Gateway_RightsOk" targetRef="Gateway_MergeOk">
